APP_ENV=local
HOST=0.0.0.0
PORT=8080
LARAVEL_API_URL=http://127.0.0.1:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=laravel_database_name
DB_DATABASE=laravel_database_name

MOBILE_UPLOAD_DIRECTORY=storage/mobile-comprobantes

# La API Dart comparte la base existente de Laravel.
# No habilites migraciones Dart en esta base.
LARAVEL_DB_DATABASE=laravel_database_name
MIGRATIONS_ENABLED=false
# Estas variables solo se configuran para una base independiente de Dart.
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
MIGRATION_DB_DATABASE=

# Seeders locales (solo desarrollo)
SEED_DEVELOPMENT_DATA=true
DEMO_SEED_PASSWORD=
